{
  "name": "deserved",
  "version": "0.3.0",
  "description": "A tiny Bun static file server: SPA, live reload, zero dependencies",
  "license": "MIT",
  "type": "module",
  "bin": {
    "deserved": "src/cli.ts"
  },
  "scripts": {
    "start": "bun src/cli.ts",
    "build": "bun scripts/build.ts",
    "typecheck": "tsc",
    "lint": "biome check .",
    "lint:fix": "biome check --write . --unsafe",
    "test": "bun test tests",
    "test:unit": "bun test tests/unit",
    "test:e2e": "bun test tests/e2e",
    "demo": "bun src/cli.ts tests/demo --watch --open",
    "demo:spa": "bun src/cli.ts tests/demo --spa --watch --open"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  }
}
