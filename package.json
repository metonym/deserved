{
  "name": "deserved",
  "version": "0.4.0",
  "description": "A tiny Bun static file server: SPA, live reload, zero dependencies",
  "license": "MIT",
  "type": "module",
  "bin": {
    "deserved": "src/cli.ts"
  },
  "module": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "start": "bun src/cli.ts",
    "build": "bun scripts/build.ts",
    "bench": "bun scripts/bench.ts",
    "bench:micro": "bun scripts/bench-micro.ts",
    "typecheck": "tsc",
    "lint": "biome check .",
    "lint:fix": "biome check --write . --unsafe",
    "lint:changed": "biome check --changed --since=master --no-errors-on-unmatched .",
    "lint:fix:changed": "biome check --write --unsafe --changed --since=master --no-errors-on-unmatched .",
    "test": "bun test tests",
    "test:unit": "bun test tests/unit",
    "test:e2e": "bun test tests/e2e",
    "demo": "bun src/cli.ts tests/demo --watch --open",
    "demo:spa": "bun src/cli.ts tests/demo --spa --watch --open"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/bun": "^1.4.0",
    "ostia": "^0.2.3",
    "typescript": "^7.0.2"
  }
}
